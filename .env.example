NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://accesscore:accesscore@localhost:5432/accesscore
REDIS_URL=redis://localhost:6379

# Token signing. `vault` uses HashiCorp Vault Transit (non-exportable keys, ADR-009);
# `software` uses an in-process Ed25519 key for offline dev/tests only.
SIGNER_DRIVER=vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=accesscore-dev-token
VAULT_TRANSIT_KEY=accesscore-signing

# Access/refresh token issuance.
JWT_ISSUER=https://auth.accesscore.dev
JWT_AUDIENCE=accesscore
JWT_CLOCK_SKEW=30
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
REFRESH_GRACE_SECONDS=10
JWKS_CACHE_MAX_AGE=300

# Per-IP rate limiting (global default; login/refresh are throttled tighter).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Decision cache (Redis, revision-keyed; ADR-023). Caches only context-independent
# (pure ReBAC) decisions; a tuple/policy write advances the revision and invalidates.
DECISION_CACHE_ENABLED=true
DECISION_CACHE_TTL_SECONDS=60

# Decision log (ADR-024). Async batching keeps the insert off the check hot path: entries are
# buffered in memory and flushed as one multi-row INSERT on an interval or batch-size trigger,
# plus a final flush on shutdown. At the buffer high-watermark writes degrade to synchronous
# inserts (completeness over latency). Set DECISION_LOG_ASYNC=false for fully synchronous logging.
DECISION_LOG_ASYNC=true
DECISION_LOG_BUFFER_SIZE=10000
DECISION_LOG_FLUSH_BATCH_SIZE=500
DECISION_LOG_FLUSH_INTERVAL_MS=1000

# Watch API (ADR-025). GET /authz/watch streams relationship-tuple changes over SSE, cursored by
# the global revision. Streams close after MAX_STREAM_SECONDS and are resumed by the client via
# Last-Event-ID; that bound is what keeps a stalled consumer from accumulating server-side.
WATCH_POLL_INTERVAL_MS=500
WATCH_PAGE_SIZE=200
WATCH_HEARTBEAT_SECONDS=15
WATCH_MAX_STREAM_SECONDS=300

# Console (apps/console) — the Next.js BFF proxies browser calls to this AccessCore API.
ACCESSCORE_API_URL=https://auth.deviego.xyz
