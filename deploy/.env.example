# Server-side configuration for deploy/compose.yml. Copy to deploy/.env on the host.
# Never commit the real file. Generate every secret with: openssl rand -hex 32

# Immutable image tag published by the Release workflow (the full commit SHA).
ACCESSCORE_IMAGE_TAG=

# Public hostnames routed by the shared Traefik instance.
API_HOST=auth.deviego.xyz
CONSOLE_HOST=console.deviego.xyz

# Postgres: owner role (runs migrations) and least-privilege runtime role (ADR-018).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

REDIS_PASSWORD=

# Dev-server Vault root token. Must not be the local default or the API refuses to boot.
VAULT_TOKEN=

LOG_LEVEL=info
