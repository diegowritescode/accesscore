{
  "name": "accesscore",
  "version": "0.0.0",
  "private": true,
  "description": "AccessCore \u2014 a self-hostable Identity & Access Management platform with a hybrid ReBAC + RBAC + ABAC authorization engine.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "arch": "turbo run arch",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.9",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "js-yaml@>=5.0.0 <5.4.1": "^5.4.1",
      "nanoid@<3.3.18": "^3.3.19",
      "postcss@<8.5.23": "^8.5.23",
      "qs@<6.16.0": "^6.16.0",
      "baseline-browser-mapping@<2.11.0": "^2.11.0"
    }
  }
}
